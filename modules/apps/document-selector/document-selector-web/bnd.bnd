Bundle-Name: Liferay Document Selector Web
Bundle-SymbolicName: com.liferay.document.selector.web
Bundle-Version: 1.0.0
Export-Package: com.liferay.document.selector
Include-Resource:\
	classes,\
	META-INF/resources=src/META-INF/resources
Provide-Capability:\
	osgi.extender;osgi.extender="jsp.taglib";uri="http://liferay.com/tld/document-selector/ui";version:Version="1.0.0"
Web-ContextPath: /document-selector-web